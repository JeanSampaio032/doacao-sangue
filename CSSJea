body {
  font-family: 'Arial', sans-serif;
  margin: 0;
  background-color: #fefefe;
  color: #333;
}

.container {
  max-width: 960px;
  margin: 0 auto;
  padding: 20px;
}

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #eee;
  padding: 10px 0;
}

.logo {
  font-weight: bold;
  color: #c0392b;
  font-size: 18px;
}

nav a {
  margin: 0 10px;
  color: #333;
  text-decoration: none;
  font-weight: 500;
}

nav a.active {
  color: #e48b9c;
  font-weight: bold;
}

.user-icons {
  font-size: 18px;
}

main h1 {
  font-size: 26px;
  margin-top: 20px;
}

.search {
  width: 100%;
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 8px;
  margin: 20px 0;
  font-size: 14px;
}

h2 {
  margin-top: 40px;
  font-size: 20px;
  color: #222;
}

.cards-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.card {
  flex: 1 1 calc(50% - 10px);
  background: #fff6f8;
  border-radius: 10px;
  padding: 16px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  min-width: 280px;
}

.card .icon {
  font-size: 24px;
  color: #e74c3c;
}

.card h3 {
  margin: 10px 0 5px;
  font-size: 16px;
  font-weight: 600;
}

.card p {
  font-size: 14px;
  margin: 2px 0;
}

footer {
  margin-top: 60px;
  text-align: center;
  background-color: #fceff1;
  padding: 20px;
  font-size: 13px;
  color: #777;
}
